{
  "name": "nuxt-pglite",
  "version": "0.3.2",
  "description": "A Nuxt module aimed to simplify the use of PGlite.",
  "keywords": [
    "database",
    "electric-sql",
    "nuxt",
    "nuxt-module",
    "nuxt-pglite",
    "pglite",
    "postgresql",
    "typescript",
    "wasm"
  ],
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": "sandros94/nuxt-pglite",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./core": {
      "types": "./dist/runtime/core/index.d.ts",
      "import": "./dist/runtime/core/index.js"
    },
    "./socket": {
      "types": "./dist/runtime/socket/index.d.ts",
      "import": "./dist/runtime/socket/index.js"
    },
    "./migrations": {
      "types": "./dist/runtime/migrations/index.d.ts",
      "import": "./dist/runtime/migrations/index.js"
    },
    "./testing": {
      "types": "./dist/runtime/testing/index.d.ts",
      "import": "./dist/runtime/testing/index.js"
    },
    "./testing/vitest": {
      "types": "./dist/runtime/testing/vitest.d.ts",
      "import": "./dist/runtime/testing/vitest.js"
    }
  },
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && nuxt prepare test/fixtures/basic && nuxt prepare test/fixtures/testing && nuxt prepare docs",
    "docs": "nuxt dev docs",
    "docs:build": "nuxt build docs",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "automd && oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "postinstall": "pnpm dev:prepare && pnpm simple-git-hooks",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/runtime/server && pnpm -F nuxt-pglite-playground typecheck && pnpm -F nuxt-pglite-docs typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "vitest run --project e2e",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "npm:@nuxt/devtools-kit@^3.4.2",
    "@nuxt/kit": "npm:@nuxt/kit@^4.6.0",
    "defu": "npm:defu@^6.1.7",
    "jiti": "^2.7.0",
    "mlly": "npm:mlly@^1.8.2",
    "pathe": "npm:pathe@^2.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.8",
    "@electric-sql/pglite-sync": "npm:@electric-sql/pglite-sync@^0.6.9",
    "@nuxt/module-builder": "npm:@nuxt/module-builder@^1.0.3",
    "@nuxt/schema": "npm:@nuxt/schema@^4.6.0",
    "@nuxt/test-utils": "npm:@nuxt/test-utils@4.3.3",
    "@playwright/test": "npm:@playwright/test@^1.63.0",
    "@types/pg": "^8.23.1",
    "@vue/test-utils": "npm:@vue/test-utils@^2.5.1",
    "automd": "^0.4.3",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-rc.4",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-rc.4",
    "happy-dom": "npm:happy-dom@^20.14.5",
    "nitro": "npm:nitro@^3.0.260903-beta",
    "nitropack": "npm:nitropack@^2.13.4",
    "nuxt": "npm:nuxt@^4.6.0",
    "oxfmt": "npm:oxfmt@^0.72.0",
    "oxlint": "npm:oxlint@^1.87.0",
    "oxlint-tsgolint": "npm:oxlint-tsgolint@~7.0.2003",
    "pg": "^8.23.1",
    "playwright-core": "npm:playwright-core@^1.63.0",
    "postgres": "^3.4.9",
    "simple-git-hooks": "npm:simple-git-hooks@^2.14.0",
    "typescript": "npm:typescript@^6.0.3",
    "vitest": "npm:vitest@^5.0.3",
    "vue": "npm:vue@^3.5.43",
    "vue-tsc": "npm:vue-tsc@^3.3.12"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
