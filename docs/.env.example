# Public URL, used for the OG images and the llms.txt links
NUXT_PUBLIC_SITE_URL=

# The server demo uses Netlify Database, whose `NETLIFY_DB_URL` Netlify sets
# once the database is enabled on the site. Leave it unset in `nuxt dev`: the
# development socket sets it (and `NETLIFY_DB_DRIVER=server`) to its own URL.
NETLIFY_DB_URL=
