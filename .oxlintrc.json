{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "import", "node", "vitest"],
  "options": { "typeAware": true, "typeCheck": true },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },

  "ignorePatterns": [
    "**/CHANGELOG.md",
    "**/pnpm*.yaml",
    "**/dist/**",
    "**/*.gen.ts",
    "**/.output/**",
    "**/.data/**",
    "**/.nuxt/**",
    "**/.nitro/**",
    "**/.cache/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/.pgdata/**",
    "**/drizzle/**"
  ]
}
